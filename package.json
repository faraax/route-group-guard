{
  "name": "route-group-guard",
  "version": "0.1.0",
  "description": "Automatic Next.js route protection driven by your (public)/(private)/(ROLE) Route Groups — no manual roleRoutes maps, no hand-written middleware.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./instrumentation": "./src/instrumentation.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "route-group-guard": "./bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "nextjs",
    "next.js",
    "middleware",
    "route-guard",
    "rbac",
    "auth",
    "route-groups",
    "jwt",
    "app-router"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "peerDependencies": {
    "next": ">=13.4.0"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "next": "^16.2.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
